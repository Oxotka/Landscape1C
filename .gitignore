# Папка для ручной выгрузки на хостинг
/dist/

# OS
.DS_Store

# Claude Code: скиллы публикуем (глобальный gitignore прячет .claude/ — отменяем),
# локальные настройки — нет
!.claude/
.claude/settings.local.json

# Python-кэш локального сервера
__pycache__/

# Статические страницы карточек — генерит scripts/sitegen.js при сборке
app/tools/

# Бот-опросник: собранные ответы, состояние сессий и кэш телеграма
# (пререндеренные логотипы bot/logos-png/ наоборот коммитятся)
bot/answers.jsonl
# Лок журнала ответов (store.withAnswersLock) — живёт только на время записи,
# но остаётся на диске, если процесс упал внутри секции
bot/answers.jsonl.lock
bot/state.json
bot/state-max.json
bot/test/tmp/
bot/file-ids.json
bot/reminders.json
bot/reminders-max.json
# Снимки сессий (список адресатов рассылки notify.js) — chat_id, в git нельзя
bot/state-test-*.json
# Снимок журнала промежуточного опроса (сырье для склейки базовых в «Итоги
# 2026»); обезличен, но публикация датасета — отдельное решение, не по умолчанию
bot/answers-test-*.jsonl
# Локальные агрегаты текущей волны — обновляет survey-live.command
.survey-live.env
app/survey2026-live.js
app/survey2026-live.js.tmp
# Агрегат волны для витрины — генерит bot/aggregate.js. Тестовая волна
# публикуется как /test_survey (агрегаты без ПДн), поэтому файл в репозитории.
# Ранбук волны с адресом сервера — локальный, копия на сервере в /root
bot/RUNBOOK.local.md

# Локальные git worktree для изолированной реализации планов
.worktrees/
